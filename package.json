{
  "name": "clipmaster",
  "version": "5.0.0",
  "description": "Local-first Windows clipboard knowledge manager with secure search, quick paste, privacy controls, and image history.",
  "author": "ClipMaster Team",
  "license": "MIT",
  "keywords": [
    "clipboard-manager",
    "windows",
    "electron",
    "react",
    "typescript",
    "productivity",
    "privacy",
    "local-first",
    "clipboard-history"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhadb/ClipMaster.git"
  },
  "bugs": {
    "url": "https://github.com/dhadb/ClipMaster/issues"
  },
  "homepage": "https://github.com/dhadb/ClipMaster#readme",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build && electron-builder --publish=never",
    "preview": "vite preview",
    "electron:dev": "vite",
    "test": "vitest run",
    "check": "npm run typecheck && vitest run && vite build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:release": "npm run typecheck && vite build && electron-builder --publish=never -c.forceCodeSigning=true"
  },
  "build": {
    "appId": "com.clipmaster.app",
    "productName": "ClipMaster",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/icon.ico",
      "public/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ClipMaster",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "license": null
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "lucide-react": "^0.292.0",
    "pinyin-pro": "^3.28.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "safe-regex2": "^5.1.1",
    "zustand": "^4.4.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.16",
    "electron": "^44.2.0",
    "electron-builder": "^26.16.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.31",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.4",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "undici": "7.29.0"
  }
}
